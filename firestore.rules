rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Games are joined by a shared code, including guests who have no
    // email/password account. Reads and writes are open to anyone with the
    // link; the game id is the access token.
    match /games/{gameId} {
      allow read, write: if true;
    }

    function friendsList(data) {
      return 'friends' in data ? data.friends : [];
    }

    function onlyFriendsChanged() {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['friends']);
    }

    // Accept/remove friend updates the other user's friends array by
    // adding or removing only the signed-in uid.
    function addedOnlySelfToFriends() {
      return onlyFriendsChanged()
        && request.resource.data.friends.hasAll(friendsList(resource.data))
        && request.resource.data.friends.hasAll([request.auth.uid])
        && request.resource.data.friends.size() == friendsList(resource.data).size() + 1;
    }

    function removedOnlySelfFromFriends() {
      return onlyFriendsChanged()
        && friendsList(resource.data).hasAll(request.resource.data.friends)
        && friendsList(resource.data).hasAll([request.auth.uid])
        && request.resource.data.friends.size() == friendsList(resource.data).size() - 1;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, delete: if request.auth != null
        && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId
        || addedOnlySelfToFriends()
        || removedOnlySelfFromFriends()
      );
    }

    match /users/{userId}/friend_requests/{requestId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == userId || request.auth.uid == requestId);
    }

    match /series/{seriesId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
