rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Games are joined by a shared code, including guests who have no
    // email/password account. Reads and writes are open to anyone with the
    // link; the game id is the access token.
    match /games/{gameId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/friend_requests/{requestId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == userId || request.auth.uid == requestId);
    }

    match /series/{seriesId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
